[Unit]
Description=SweetBuzz Honey Pot Web App
After=network.target

[Service]
User=nix01
WorkingDirectory=/home/nix01/honeypot_app
EnvironmentFile=/etc/honeypots/sweetbuzz.env
ExecStart=/home/nix01/honeypot_app/venv/bin/gunicorn --workers 2 --bind 0.0.0.0:5000 app:app
Restart=always

[Install]
WantedBy=multi-user.target
