[Unit]
Description=FTP honeypot (port 21, PASV 30000-30009)
After=network-online.target
Wants=network-online.target

[Service]
User=honeypot
Group=honeypot
Environment=HP_LOG_DIR=/var/log/honeypots HP_DATA_DIR=/var/lib/honeypots HP_FTP_PORT=21
Environment=HP_FTP_PASV_MIN=30000 HP_FTP_PASV_MAX=30009
ExecStart=/opt/honeypots/venv/bin/python /opt/honeypots/ftp_honeypot.py
Restart=always
RestartSec=3
# port 21 < 1024 sans root : uniquement cette capacité
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/log/honeypots /var/lib/honeypots

[Install]
WantedBy=multi-user.target
